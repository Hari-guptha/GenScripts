# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27017/genscripts?authSource=admin
MONGODB_DATABASE=genscripts

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_QUEUE_WEB_CRAWLER=web_crawler_queue
RABBITMQ_QUEUE_DOCUMENT_EXTRACTOR=document_extractor_queue
RABBITMQ_QUEUE_PAPER_FETCHER=paper_fetcher_queue
RABBITMQ_QUEUE_LLM_GENERATION=llm_generation_queue
RABBITMQ_QUEUE_FORMATTER=formatter_queue

# OpenSearch Configuration
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_INDEX_PAPERS=papers
OPENSEARCH_INDEX_CHUNKS=chunks

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# File Storage
FILE_STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# API Configuration
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# LLM Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
